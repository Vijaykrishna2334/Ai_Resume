# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_resume"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AI Provider
GEMINI_API_KEY="your-gemini-api-key-here"
# Get your API key from: https://aistudio.google.com/app/apikey

# File Storage (for production)
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"

# Email Providers (choose one for job alerts)
# Option 1: Resend (recommended - free tier: 100 emails/day)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="noreply@your domain.com"
# Get API key from: https://resend.com

# Option 2: SendGrid
# SENDGRID_API_KEY="SG...."
# SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# Job Alerts - Job Search APIs (optional, uses demo jobs if not configured)
# Adzuna API (free tier available)
# ADZUNA_APP_ID="your-app-id"
# ADZUNA_API_KEY="your-api-key"
# ADZUNA_COUNTRY="us"
# Get API key from: https://developer.adzuna.com/

# RapidAPI (for JSearch and other job APIs)
# RAPIDAPI_KEY="your-rapidapi-key"
# Get API key from: https://rapidapi.com

# Cron Job Security
# Generate a random secret for cron job authentication
CRON_SECRET="generate-a-random-secret-here"

# Optional
# SENTRY_DSN=""
# RATE_LIMIT_MAX="100"
# RATE_LIMIT_WINDOW="15"
