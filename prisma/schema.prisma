generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  applications  Application[]
  documents     Document[]
  interviews    MockInterview[]
  portfolio     Portfolio?
  jobAlertPreferences JobAlertPreferences?
  jobMatches    JobMatch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  summary   String?
  skills    String[]

  experience Json[]
  projects  Json[]
  education Json[]

  rawResumeData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  company     String
  position    String
  jobUrl      String?
  jobDescription String @db.Text

  status      ApplicationStatus @default(APPLIED)
  matchScore  Int?

  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interviews  Interview[]
  documents   Document[]
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  ACCEPTED
  DECLINED
}

model Interview {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type          InterviewType
  scheduledAt   DateTime?
  completedAt   DateTime?
  outcome       String?
  notes         String? @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  ONSITE
  FINAL
  OTHER
}

model Document {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  type          DocumentType
  fileName      String
  fileUrl       String
  filePath      String
  mimeType      String

  metadata      Json?

  createdAt     DateTime @default(now())
}

enum DocumentType {
  UPLOADED_RESUME
  GENERATED_RESUME
  COVER_LETTER
  PORTFOLIO
  OTHER
}

model MockInterview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle  String?
  questions Json[]
  feedback  Json?

  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String   @unique
  template    String   @default("minimalist")

  isPublished Boolean  @default(false)
  publishedAt DateTime?

  settings    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiUsage {
  id        String   @id @default(cuid())
  userId    String

  endpoint  String
  provider  String
  model     String

  tokensIn  Int
  tokensOut Int
  cost      Float

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model JobAlertPreferences {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled           Boolean  @default(true)
  notificationEmail String
  notificationTime  String   // Format: "HH:MM" in 24-hour format (e.g., "09:00")
  timezone          String   @default("UTC")

  maxJobsPerDay     Int      @default(10)
  minMatchScore     Int      @default(70) // Only send jobs with match score >= this value

  // Job preferences
  desiredRoles      String[] // e.g., ["Software Engineer", "Full Stack Developer"]
  locations         String[] // e.g., ["Remote", "New York", "San Francisco"]
  jobTypes          String[] // e.g., ["Full-time", "Contract", "Remote"]
  experienceLevels  String[] // e.g., ["Mid-level", "Senior"]
  salaryMin         Int?
  salaryMax         Int?

  lastSentAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Job {
  id              String   @id @default(cuid())

  // Job details
  title           String
  company         String
  location        String?
  jobType         String?  // Full-time, Part-time, Contract, Remote
  experienceLevel String?  // Entry, Mid, Senior, Lead
  description     String   @db.Text
  requirements    String?  @db.Text
  salary          String?

  // Source information
  source          String   // e.g., "LinkedIn", "Indeed", "Glassdoor"
  externalId      String   // ID from the source platform
  jobUrl          String

  // Metadata
  postedAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  matches         JobMatch[]

  @@unique([source, externalId])
  @@index([isActive, postedAt])
  @@index([title, company])
}

model JobMatch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  matchScore  Int      // 0-100
  matchReason String?  @db.Text // AI-generated explanation of why it's a match

  // Tracking
  sentAt      DateTime?
  viewedAt    DateTime?
  appliedAt   DateTime?

  createdAt   DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId, sentAt])
  @@index([matchScore])
}
